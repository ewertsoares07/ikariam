rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita para o documento de salvamento do império
    match /imperial_saves/{docId} {
      allow read, write: if true;
    }
    
    // Regra padrão de fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
